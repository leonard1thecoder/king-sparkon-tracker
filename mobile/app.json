{
  "expo": {
    "name": "King Sparkon",
    "slug": "king-sparkon-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kingsparkon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingsparkon.tracker",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcodes, QR codes and ticket codes at the counter."
      }
    },
    "android": {
      "package": "com.kingsparkon.tracker",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow King Sparkon to scan barcodes and tickets."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2f3b5176-68aa-4051-bd31-48299e8f1195"
      }
    }
  }
}
